# ============================================================
# APP
# ============================================================
APP_NAME="Enterprise DB RAG Assistant"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ============================================================
# TARGET COMPANY DATABASE — READ-ONLY. This is the database the
# chatbot analyzes and answers questions about. The user configured
# here MUST be a database role with SELECT-only privileges.
# ============================================================
TARGET_DB_URL=postgresql+psycopg2://readonly_user:readonly_password@company-db-host:5432/company_db
TARGET_DB_POOL_SIZE=5
TARGET_DB_STATEMENT_TIMEOUT_MS=15000
TARGET_DB_MAX_ROWS_RETURNED=500

# ============================================================
# APPLICATION DATABASE — read/write, but this is OUR OWN backend's
# storage (users, conversation history, cached docs, alerts).
# It is never the customer's protected database.
# ============================================================
APP_DB_URL=postgresql+psycopg2://app_user:app_password@localhost:5432/rag_backend_app

# ============================================================
# JWT AUTH
# ============================================================
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================================
# MULTI-PROVIDER LLM SWITCHING (Groq / Gemini / Ollama)
# ============================================================
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_S=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT_S=30

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_S=60

# ============================================================
# CHROMADB (vector store)
# ============================================================
CHROMA_PERSIST_DIR=./vector_db
CHROMA_COLLECTION_NAME=db_knowledge_base

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PER_MINUTE=60

# ============================================================
# NOTIFICATIONS
# ============================================================
NOTIFY_MIN_SEVERITY=high      # low | medium | high | critical

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=["admin@example.com"]

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=

GENERIC_WEBHOOK_ENABLED=false
GENERIC_WEBHOOK_URL=

# ============================================================
# HEALTH MONITORING
# ============================================================
HEALTH_CHECK_INTERVAL_MINUTES=60
NULL_RATIO_WARNING_THRESHOLD=0.4

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=./logs
