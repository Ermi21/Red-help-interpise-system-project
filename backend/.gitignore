# --- Secrets / local config ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Local dev databases (SQLite files used for local testing only) ---
*.db
*.sqlite
*.sqlite3

# --- Vector store data / logs (regenerated at runtime, not source) ---
vector_db/*
!vector_db/.gitkeep
logs/*
!logs/.gitkeep

# --- IDE ---
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# --- OS ---
.DS_Store
Thumbs.db
